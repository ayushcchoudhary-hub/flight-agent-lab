    "name": "Booking refusal preserves the active trip",
    "requirement": "Refuse booking, keep the active route and date, then handle the same-day timing request without losing them.",
    "steps": [
      {
        "text": "London to Dubai 2 Oct",
        "expected": {
          "status": "results",
          "origin": "LHR|LGW|LCY|STN|LTN",
          "destination": "DXB|AUH",
          "cabin": "business",
          "from": "2026-10-02",
          "to": "2026-10-02",
          "posts": 1
        }
      },
      {
        "text": "book option A",
        "expected": {
          "status": "clarify",
          "origin": "LHR|LGW|LCY|STN|LTN",
          "destination": "DXB|AUH",
          "from": "2026-10-02",
          "to": "2026-10-02",
          "posts": 1,
          "mentions": "checkout|book"
