{
  "name": "flight-agent-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import ./register.mjs cli.mjs",
    "demo": "node --import ./register.mjs cli.mjs --demo",
    "test": "node --import ./register.mjs --test test/*.test.mjs",
    "eval": "node --import ./register.mjs eval.mjs",
    "eval:live": "node --import ./register.mjs eval-live.mjs",
    "dashboard": "node dashboard-server.mjs",
    "dashboard:account": "node --import ./register.mjs local-account-lab.mjs",
    "experiment": "node --import ./register.mjs experiment-server.mjs",
    "eval:openrouter": "node --import ./register.mjs openrouter-benchmark.mjs",
    "eval:combine": "node combine-comparisons.mjs",
    "eval:chart": "node generate-model-chart.mjs",
    "eval:harden": "node --import ./register.mjs hardening-judge-eval.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
