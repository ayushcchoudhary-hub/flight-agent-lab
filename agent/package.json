{
  "name": "flight-agent-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import ./register.mjs apps/cli.mjs",
    "demo": "node --import ./register.mjs apps/cli.mjs --demo",
    "test": "node --import ./register.mjs --test test/*.test.mjs",
    "eval": "node --import ./register.mjs evals/eval.mjs",
    "eval:live": "node --import ./register.mjs evals/eval-live.mjs",
    "dashboard": "node apps/dashboard-server.mjs",
    "experiment": "node --import ./register.mjs apps/experiment-server.mjs",
    "eval:openrouter": "node --import ./register.mjs evals/openrouter-benchmark.mjs",
    "eval:combine": "node evals/combine-comparisons.mjs",
    "eval:chart": "node evals/generate-model-chart.mjs",
    "eval:harden": "node --import ./register.mjs evals/hardening-judge-eval.mjs",
    "policy:check": "node tools/policy-sync.mjs",
    "policy:sync": "node tools/policy-sync.mjs --write",
    "format": "prettier --write \"**/*.mjs\" \"dashboard/*.js\" \"dashboard/*.css\"",
    "format:check": "prettier --check \"**/*.mjs\" \"dashboard/*.js\" \"dashboard/*.css\""
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
