# Default: existing Codex ChatGPT login; no API key required.
AGENT_PROVIDER=codex
AGENT_CODEX_MODEL=gpt-6-astra
AGENT_REASONING=low
# Optional later: set AGENT_PROVIDER=openrouter and fill these locally.
OPENROUTER_API_KEY=
# Exact OpenRouter model ID supporting tools; choose before first live run.
AGENT_MODEL=
AGENT_TIMEZONE=Europe/London
# For repeatable experiments only; omit to use today's local date.
# AGENT_TODAY=2026-09-18

# Only used with --staging. Keep this file outside the repository, permissions 600.
# AGENT_STAGING_TOKEN_FILE=/absolute/private/path/staging-session-token
