  {
    "id": "A7",
    "category": "Places",
    "name": "Unsupported city is never silently replaced",
    "requirement": "Search Paris to New York when supported. Otherwise state the Paris limitation plainly. Never substitute another origin.",
    "steps": [
      {
        "text": "Paris to New York on 1 October",
        "expected": {
          "outcomes": [
            {
              "status": "results",
              "origin": "CDG|ORY",
              "destination": "JFK|EWR|LGA",
              "from": "2026-10-01",
              "to": "2026-10-01",
              "posts": 1
            },
            {
              "status": "clarify",
              "posts": 0,
              "mentions": "Paris.*not supported|not supported.*Paris"
            }
          ]
        }
      }
    ]
  },
