  {
    "id": "A1",
    "category": "Places",
    "name": "Country destination becomes an airport menu",
    "requirement": "Offer a numbered menu of Japan’s main airports, keep London and next week, and ask one concise question.",
    "steps": [
      {
        "text": "London to Japan next week",
        "expected": {
          "status": "clarify",
          "posts": 0,
          "origin": "LHR|LGW|LCY|STN|LTN",
          "destination": null,
          "pending": "destination",
          "from": "2026-09-21",
          "to": "2026-09-27",
          "mentions": "(?=.*Tokyo)(?=.*Osaka)"
        }
      }
    ]
  },
  {
