  {
    "id": "C1",
    "category": "Multi-turn state",
    "name": "Five refinements change only named fields",
    "requirement": "Preserve the route while applying Gatwick, 3 October, premium economy and a cleared budget. \"Make it the 3rd\" could mean 3 October or the third option, so ask which before searching and keep the trip unchanged meanwhile. Make no more than five searches. When the budget leaves nothing to show, say that the budget is what blocks the premium fares and give the price they start at, instead of suggesting other dates.",
    "steps": [
      {
        "text": "London to New York 1 Oct economy under 700",
        "expected": {
          "status": "results",
          "origin": "LHR|LGW|LCY|STN|LTN",
          "destination": "JFK|EWR|LGA",
          "cabin": "economy",
          "from": "2026-10-01",
          "to": "2026-10-01",
          "posts": 1,
          "budget": 700
        }
      },
      {
        "text": "Gatwick only",
        "expected": {
          "status": "results",
          "origin": "LGW",
          "destination": "JFK|EWR|LGA",
          "cabin": "economy",
          "from": "2026-10-01",
          "to": "2026-10-01",
          "posts": 2,
          "budget": 700
        }
      },
      {
        "text": "make it the 3rd",
        "expected": {
          "status": "clarify",
          "origin": "LGW",
          "destination": "JFK|EWR|LGA",
          "cabin": "economy",
          "from": "2026-10-01",
          "to": "2026-10-01",
          "budget": 700,
          "posts": 2,
          "mentions": "(?=.*oct)(?=.*option)"
        }
      },
      {
        "text": "I mean 3 October",
        "expected": {
          "status": "results",
          "origin": "LGW",
          "destination": "JFK|EWR|LGA",
          "cabin": "economy",
          "from": "2026-10-03",
          "to": "2026-10-03",
          "posts": 3,
          "budget": 700
        }
      },
      {
        "text": "premium instead",
        "expected": {
          "status": "results",
          "origin": "LGW",
          "destination": "JFK|EWR|LGA",
          "cabin": "premium",
          "from": "2026-10-03",
          "to": "2026-10-03",
          "posts": 4,
          "budget": 700,
          "mentions": "(?=.*[Bb]udget)(?=.*USD)"
        }
      },
      {
        "text": "drop the budget",
        "expected": {
          "status": "results",
          "origin": "LGW",
          "destination": "JFK|EWR|LGA",
          "cabin": "premium",
          "from": "2026-10-03",
          "to": "2026-10-03",
          "posts": 4,
          "budget": null,
          "mentions": "[Bb]udget removed|[Rr]emoved the budget|without a budget"
        }
      }
    ]
  },
  {
    "id": "C2",
    "category": "Multi-turn state",
    "name": "Policy detour preserves trip state",
    "requirement": "Answer the refund question honestly, preserve the trip through that turn, then sort the same nonstop search by cheapest. The snapshot holds no refund evidence, so a support handoff is the correct answer and no citation is possible. Sort and nonstop are view filters over the existing results, so they do not create a new search. Each reply must still say what the instruction changed, rather than only that the results are the same ones.",
    "steps": [
      {
        "text": "Singapore to London next week",
        "expected": {
          "status": "results",
          "origin": "SIN",
          "destination": "LHR|LGW|LCY|STN|LTN",
          "cabin": "business",
          "from": "2026-09-21",
          "to": "2026-09-27",
          "posts": 1
        }
      },
      {
        "text": "nonstop only",
        "expected": {
          "status": "results",
          "origin": "SIN",
          "destination": "LHR|LGW|LCY|STN|LTN",
          "from": "2026-09-21",
          "to": "2026-09-27",
          "posts": 1
        }
      },
      {
        "text": "what is your refund policy?",
        "expected": {
          "status": "policy",
          "posts": 1,
          "sourceOrSupport": true
        }
      },
      {
        "text": "ok cheapest first",
        "expected": {
          "status": "results",
          "origin": "SIN",
          "destination": "LHR|LGW|LCY|STN|LTN",
          "from": "2026-09-21",
          "to": "2026-09-27",
          "sort": "cheapest",
          "nonstopOnly": true,
          "posts": 1,
          "mentions": "[Ss]orted by cheapest|[Cc]heapest first"
        }
      }
    ]
  },
  {
    "id": "C3",
    "category": "Multi-turn state",
    "name": "Booking refusal preserves the active trip",
